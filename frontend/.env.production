# This file is safe to commit — it contains NO secrets.
# It only tells the frontend where the backend lives in production.
#
# IMPORTANT: Replace this URL with your actual Railway backend URL
# after you deploy. You get it from Railway → your service → Settings → Domain.
#
# Format: https://devpulse-backend-production.up.railway.app
# (Railway generates this automatically — no custom domain needed)

REACT_APP_API_URL=https://your-backend.up.railway.app
