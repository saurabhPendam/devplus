# ─────────────────────────────────────────────────────────────
# DevPulse Backend — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file:   cp .env.example .env
# NEVER commit .env to Git — it contains secrets.
# On Railway: add these in Settings → Variables (not as a file).
# ─────────────────────────────────────────────────────────────

# Port — Railway sets this automatically. 5000 is the local default.
PORT=5000

# NODE_ENV — set to "production" on Railway (done automatically).
NODE_ENV=development

# The URL of your Vercel frontend.
# Railway uses this for the CORS allowlist.
# Example: https://devpulse.vercel.app
CLIENT_URL=http://localhost:3000

# ── GitHub Personal Access Token ─────────────────────────────
# Without this: 60 API requests / hour (enough for testing).
# With this: 5,000 requests / hour (needed for production).
#
# How to get one:
#   1. Go to github.com → Settings → Developer settings
#   2. Personal access tokens → Tokens (classic) → Generate new token
#   3. Name it "devpulse-production"
#   4. No scopes needed — DevPulse only reads public data
#   5. Copy the token and paste it below
#
GITHUB_TOKEN=ghp_your_token_here
