# ─────────────────────────────────────────────────────────────
# DevPulse Backend — Environment Variables
# ─────────────────────────────────────────────────────────────
# Local: copy this file → cp .env.example .env
# Render: add these in Dashboard → your service → Environment
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────

# Port — Render sets this automatically. 5000 is local default.
PORT=5000

# Set to "production" on Render (Render sets this automatically).
NODE_ENV=development

# Your Vercel frontend URL — used for CORS.
# Example: https://devpulse.vercel.app
# Add this AFTER you deploy the frontend to Vercel.
CLIENT_URL=http://localhost:3000

# ── GitHub Personal Access Token ─────────────────────────────
# Without: 60 API requests/hour. With: 5,000/hour.
#
# Get one:
#   github.com → Settings → Developer settings
#   → Personal access tokens → Tokens (classic)
#   → Generate new token → no scopes needed for public data
#
GITHUB_TOKEN=ghp_your_token_here
