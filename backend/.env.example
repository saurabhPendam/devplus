# Copy this file: cp .env.example .env
# Then fill in real values. NEVER commit .env to Git.

PORT=5000
CLIENT_URL=http://localhost:3000

# GitHub personal access token (optional but strongly recommended)
# Without it: 60 API requests/hr. With it: 5,000/hr.
# Get one at: https://github.com/settings/tokens
# Scopes needed: (none — public data only) or 'public_repo' + 'read:user'
GITHUB_TOKEN=ghp_your_token_here

# Anthropic API key — used in Day 5
# Get one at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your_key_here
